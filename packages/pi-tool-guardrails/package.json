{
  "name": "@arcanemachine/pi-tool-guardrails",
  "version": "0.1.0",
  "description": "Append Pi-specific tool usage guardrails to the system prompt",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "extension",
    "system-prompt",
    "guardrails"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@types/node": "^25.3.0",
    "typescript": "^5.7.2"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE.md"
  ]
}
